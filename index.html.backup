<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="theme-color" content="#faf8f4">
<title>Python 学习工作台</title>
<link rel="stylesheet" href="style.css">
</head>
<body>
<a class="skip-link" href="#main">跳到主要内容</a>
<header class="topbar">
  <div class="brand">
    <span class="brand-mark" aria-hidden="true">Py</span>
    <div class="brand-text">
      <h1>Python 学习工作台</h1>
      <p class="brand-sub">零基础 · 按黑马课程推进</p>
    </div>
  </div>
  <nav class="tabs" aria-label="功能导航">
    <button class="tab active" data-view="map" aria-current="page">思维导图</button>
    <button class="tab" data-view="notes">章节笔记</button>
    <button class="tab" data-view="path">学习路线</button>
    <button class="tab" data-view="cheats">速查表</button>
    <button class="tab" data-view="pomodoro">番茄钟</button>
    <button class="tab" data-view="env">环境指南</button>
    <button class="tab" data-view="links">资源导航</button>
    <button class="tab" data-view="achieve">成就墙</button>
  </nav>
  <div class="topbar-right">
    <span id="streakBadge" class="streak" title="连续学习天数">—</span>
    <button id="exportBtn" class="btn ghost" title="导出全部笔记与进度为 JSON 备份">导出备份</button>
    <button id="importBtn" class="btn ghost" title="从 JSON 备份恢复">导入</button>
    <input type="file" id="importFile" accept=".json" hidden aria-label="选择备份文件">
  </div>
</header>

<main id="main">
  <!-- ============ 思维导图 ============ -->
  <section id="view-map" class="view active" aria-label="Python 知识思维导图">
    <div class="map-toolbar">
      <div class="map-search">
        <input type="search" id="mapSearch" placeholder="搜索知识点，如：切片、列表推导式…" autocomplete="off" aria-label="搜索知识点">
        <span id="mapSearchCount" class="search-count" aria-live="polite"></span>
      </div>
      <div class="map-actions">
        <button class="btn" id="expandAll">全部展开</button>
        <button class="btn" id="collapseAll">全部收起</button>
        <button class="btn" id="expandL2">展开到二级</button>
        <span class="toolbar-sep" aria-hidden="true"></span>
        <button class="btn" id="zoomOut" aria-label="缩小">−</button>
        <span id="zoomLabel" class="zoom-label">100%</span>
        <button class="btn" id="zoomIn" aria-label="放大">+</button>
        <button class="btn" id="zoomReset">重置</button>
        <button class="btn accent" id="fitBtn">适应窗口</button>
      </div>
    </div>
    <div id="mapCanvas" class="map-canvas" tabindex="0" aria-label="思维导图画布，可拖拽平移，滚轮缩放">
      <div id="mapWorld" class="map-world"></div>
    </div>
    <aside id="nodePanel" class="node-panel" hidden aria-label="知识点详情">
      <div class="node-panel-head">
        <h2 id="npTitle">—</h2>
        <button id="npClose" class="btn ghost" aria-label="关闭详情面板">×</button>
      </div>
      <div id="npBody" class="node-panel-body"></div>
    </aside>
    <p class="map-hint">点节点看讲解 · 点 <b>+/−</b> 圆点展开收起 · 拖拽空白处平移 · 滚轮缩放</p>
  </section>

  <!-- ============ 章节笔记 ============ -->
  <section id="view-notes" class="view" aria-label="章节笔记">
    <div class="notes-layout">
      <aside class="chapter-list" aria-label="课程章节">
        <div class="chapter-list-head">
          <h2>课程章节</h2>
          <span id="chapterProgress" class="chapter-progress"></span>
        </div>
        <ol id="chapterNav"></ol>
      </aside>
      <div class="note-editor">
        <div class="note-head">
          <div>
            <h2 id="noteTitle">—</h2>
            <p id="noteTopics" class="note-topics"></p>
          </div>
          <label class="done-toggle">
            <input type="checkbox" id="chapterDone">
            <span>本章已学完</span>
          </label>
        </div>
        <div id="memoryPack" class="memory-pack"></div>
        <div class="note-toolbar" role="toolbar" aria-label="笔记格式工具">
          <button class="btn small" data-md="**" title="加粗">B</button>
          <button class="btn small" data-md="`" title="行内代码">code</button>
          <button class="btn small" data-block="```python&#10;&#10;```" title="插入代码块">{ }</button>
          <button class="btn small" data-line="- " title="列表">• 列表</button>
          <button class="btn small" data-line="## " title="小标题">H2</button>
          <button class="btn small" data-line="> " title="引用">引用</button>
          <button class="btn small" data-block="&#10;| 列1 | 列2 |&#10;| --- | --- |&#10;|  |  |&#10;" title="表格">表格</button>
          <span class="toolbar-sep" aria-hidden="true"></span>
          <button class="btn small" id="togglePreview">预览</button>
          <button class="btn small" id="downloadNote">下载 .md</button>
        </div>
        <div class="note-body">
          <textarea id="noteArea" spellcheck="false" aria-label="笔记编辑区，支持 Markdown 语法" placeholder="在这里记笔记，支持 Markdown 语法…&#10;&#10;建议格式：&#10;## 今天学了什么&#10;## 代码练习&#10;## 踩过的坑&#10;## 还没弄懂的问题"></textarea>
          <div id="notePreview" class="note-preview" hidden></div>
        </div>
        <div class="note-foot">
          <span id="saveStatus" class="save-status" aria-live="polite">自动保存已开启</span>
          <span id="wordCount" class="word-count"></span>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ 学习路线 ============ -->
  <section id="view-path" class="view narrow" aria-label="学习路线">
    <h2 class="view-title">从零到 AI 应用：四阶段路线</h2>
    <p class="view-desc">按每天 1–2 小时估算。勾选会自动保存，和导图、笔记进度互相独立，放心慢慢来。</p>
    <div id="pathStages"></div>
    <div class="path-overall">
      <span>总进度</span>
      <div class="progress-track"><div id="pathBar" class="progress-fill"></div></div>
      <span id="pathPct">0%</span>
    </div>
  </section>

  <!-- ============ 速查表 ============ -->
  <section id="view-cheats" class="view narrow" aria-label="语法速查表">
    <h2 class="view-title">语法速查表</h2>
    <p class="view-desc">忘了怎么写就来这查。点右上角「复制」直接拿走代码。</p>
    <input type="search" id="cheatSearch" class="wide-search" placeholder="过滤，如：字典、循环、文件…" autocomplete="off" aria-label="过滤速查条目">
    <div id="cheatList"></div>
  </section>

  <!-- ============ 番茄钟 ============ -->
  <section id="view-pomodoro" class="view narrow center" aria-label="番茄钟">
    <h2 class="view-title">专注番茄钟</h2>
    <p class="view-desc">25 分钟专注 + 5 分钟休息。学编程最忌一坐三小时然后三天不碰。</p>
    <div class="pomo-card">
      <div class="pomo-mode" id="pomoMode">专注</div>
      <div class="pomo-time" id="pomoTime" role="timer" aria-live="off">25:00</div>
      <div class="pomo-btns">
        <button class="btn accent big" id="pomoStart">开始</button>
        <button class="btn big" id="pomoReset">重置</button>
        <button class="btn big" id="pomoSkip">跳过休息</button>
      </div>
      <div class="pomo-settings">
        <label>专注 <input type="number" id="pomoWorkMin" min="5" max="90" value="25" aria-label="专注分钟数"> 分钟</label>
        <label>休息 <input type="number" id="pomoBreakMin" min="1" max="30" value="5" aria-label="休息分钟数"> 分钟</label>
      </div>
      <p class="pomo-today">今日完成 <b id="pomoCount">0</b> 个番茄 · 累计专注 <b id="pomoTotal">0</b> 分钟</p>
    </div>
  </section>

  <!-- ============ 环境指南 ============ -->
  <section id="view-env" class="view narrow" aria-label="环境搭建指南">
    <h2 class="view-title">学代码除了 Python 还需要什么？</h2>
    <p class="view-desc">小白最常见的困惑一次说清。你的电脑已装好 Python 3.14，下面按优先级来。</p>
    <div id="envList"></div>
  </section>

  <!-- ============ 资源导航 ============ -->
  <section id="view-links" class="view narrow" aria-label="学习资源导航">
    <h2 class="view-title">资源导航</h2>
    <p class="view-desc">精选不贪多，每个都标了怎么用。</p>
    <div id="linkGroups"></div>
  </section>
  <!-- ============ 成就墙 ============ -->
  <section id="view-achieve" class="view narrow" aria-label="成就墙">
    <h2 class="view-title">成就墙</h2>
    <p class="view-desc">学习就像打怪升级：记笔记、拆记忆包、完成番茄都能拿经验值。解锁成就时会有彩带庆祝。</p>
    <div id="achieveGrid" class="achieve-grid"></div>
    <div class="xp-rules">
      <h3>经验值规则</h3>
      <ul>
        <li>学完一章 +20 XP</li>
        <li>写一篇像样的笔记（80字以上）+10 XP</li>
        <li>拆开一个记忆包 +5 XP</li>
        <li>完成一个番茄钟 +8 XP</li>
        <li>路线清单每勾一项 +5 XP</li>
        <li>每天打卡 +3 XP</li>
      </ul>
    </div>
  </section>
</main>

<div id="toast" class="toast" role="status" aria-live="polite" hidden></div>
<script src="data-mindmap.js"></script>
<script src="data-content.js"></script>
<script src="data-memory.js"></script>
<script src="app.js"></script>
<script src="fun.js"></script>
</body>
</html>
